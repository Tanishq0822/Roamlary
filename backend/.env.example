# Copy this file to .env and adjust values for your machine.
# .env is gitignored - never commit real secrets.

# Application
APP_ENV=development
APP_NAME="Roamlary API"
APP_VERSION=1.0.0
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS - comma-separated allowed origins for the Flutter dev apps.
# Browsers enforce CORS; the origin is scheme://host[:port] of the APP.
#  - Flutter web / Windows desktop dev: http://localhost:3000
#  - Android emulator reaching your laptop: http://10.0.2.2:3000
#  - Real phone on the same Wi-Fi: http://<your-laptop-LAN-IP>:3000 (add it here)
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# Database (Phase 2). SQLAlchemy URL format:
#   postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE_NAME
# Replace PASSWORD with the password you set for your dev container.
# This file holds PLACEHOLDERS only - the real .env is gitignored.
DATABASE_URL=postgresql+psycopg://roamlary:change-me@localhost:5432/roamlary_dev
