# Copy this file to .env and adjust values for your machine.
# .env is gitignored - never commit real secrets.

# Application
APP_ENV=development
APP_NAME="Roamlary API"
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS - comma-separated allowed origins for the Flutter dev apps
# (Android emulator reaches the host via 10.0.2.2)
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# Database - used from Milestone 2 onwards (PostgreSQL via Docker)
DATABASE_URL=postgresql+psycopg://roamlary:roamlary@localhost:5432/roamlary_dev
